# Docker Compose reads this file (copy to .env). Database credentials below are local-development defaults; change them for any shared deployment.
POSTGRES_USER=auditor
POSTGRES_PASSWORD=change-me
POSTGRES_DB=auditor

# Copy to .env and edit. Never commit .env.
# DATABASE_URL is set by docker-compose; for non-Docker runs use:
# DATABASE_URL=postgresql+psycopg://auditor:auditor@localhost:5432/auditor
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# AI provider: mock (demo mode, no credentials needed) | anthropic | openai_compatible
AI_PROVIDER=mock
AI_MODEL=claude-sonnet-5-5
AI_API_KEY=
# Only for openai_compatible (e.g. https://api.openai.com/v1) or a proxy for anthropic
AI_BASE_URL=

# Browser. Set BROWSER_NO_SANDBOX=true only inside a container that runs as root.
BROWSER_EXECUTABLE_PATH=
BROWSER_NO_SANDBOX=false

# Origins allowed ONLY for URLs under /fixtures/ (lets you audit the bundled test pages).
LOCAL_FIXTURE_ORIGINS=http://127.0.0.1:8000
